# Copy this file to `.env` and fill in your values.
# Bun auto-loads `.env` from the project root on boot — no dotenv import needed.

# ─── Auth ───────────────────────────────────────────────────────────────────
# By default, ALL endpoints are open — no API key required.
# The `auth: true` flag on individual feature files is IGNORED unless you set
# ENABLE_AUTH=true below.
#
# To enforce API key on endpoints marked `auth: true`:
#   1. Set ENABLE_AUTH=true
#   2. Set API_KEY to your secret
ENABLE_AUTH=false
API_KEY=change-me

# ─── Server ─────────────────────────────────────────────────────────────────
# Port the server listens on.
PORT=47291

# ─── Rate Limit ────────────────────────────────────────────────────────────────
# Max requests per minute per IP (default: 60)
RATE_LIMIT=60
# Burst allowance (default: 10)
RATE_BURST=10

# ─── Auto-update ────────────────────────────────────────────────────────────────
# Secret for POST /admin/sync endpoint (used to sync new code from sources)
SYNC_SECRET=changeme
